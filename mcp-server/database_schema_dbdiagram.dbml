// =====================================================
// AI MOVIE NIGHT PLANNER - DATABASE SCHEMA
// For use with: https://dbdiagram.io/d
// =====================================================

Project ai_movie_night_planner {
  database_type: 'PostgreSQL'
  Note: 'Movie night planning with AI recommendations and semantic search'
}

// =====================================================
// TABLES
// =====================================================

Table users as U {
  user_id integer [pk, increment]
  user_name text [not null]
  email text [not null, unique]
  created_at timestamp [not null, default: `now()`]
  
  Note: 'User accounts for movie night planning'
}

Table groups as G {
  group_id uuid [pk, default: `gen_random_uuid()`]
  group_name text [not null]
  description text
  created_by integer [not null, ref: > U.user_id]
  created_at timestamp [not null, default: `now()`]
  is_active boolean [default: true]
  
  Note: 'Movie night groups (friends, family, etc.)'
}

Table group_members as GM {
  membership_id integer [pk, increment]
  group_id uuid [not null, ref: > G.group_id]
  user_id integer [not null, ref: > U.user_id]
  joined_at timestamp [not null, default: `now()`]
  
  indexes {
    (group_id, user_id) [unique]
  }
  
  Note: 'Many-to-many: users ↔ groups'
}

Table movies as M {
  movie_id integer [pk]
  title text [not null]
  overview text
  release_date date
  runtime integer
  tmdb_rating decimal(3,1)
  vote_count integer
  genres text
  cast text
  director text
  keywords text
  poster_path text
  embedding vector(1024)
  original_language text
  created_at timestamp [not null, default: `now()`]
  
  Note: 'Movie catalog with semantic embeddings'
}

Table ratings as R {
  rating_id integer [pk, increment]
  group_id uuid [not null, ref: > G.group_id]
  movie_id integer [not null, ref: > M.movie_id]
  user_id integer [not null, ref: > U.user_id]
  rating decimal(3,1) [not null]
  review text
  watched_date date
  created_at timestamp [not null, default: `now()`]
  
  indexes {
    (group_id, movie_id, user_id) [unique]
  }
  
  Note: 'User movie ratings (0-10 scale)'
}

Table watchlist_items as W {
  watchlist_id integer [pk, increment]
  group_id uuid [not null, ref: > G.group_id]
  movie_id integer [not null, ref: > M.movie_id]
  added_by integer [not null, ref: > U.user_id]
  status text [default: 'pending']
  added_at timestamp [not null, default: `now()`]
  watched_at timestamp
  
  indexes {
    (group_id, movie_id) [unique]
  }
  
  Note: 'Group movie watchlist'
}

Table recommendations as REC {
  recommendation_id integer [pk, increment]
  group_id uuid [not null, ref: > G.group_id]
  movie_id integer [not null, ref: > M.movie_id]
  request_by text [not null]
  request_content text
  request_embedding vector(1024)
  explanation text
  created_at timestamp [not null, default: `now()`]
  
  Note: 'AI recommendation history'
}
